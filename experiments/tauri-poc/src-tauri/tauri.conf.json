{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screen Spirit Tauri POC",
  "version": "0.1.0",
  "identifier": "local.screen-spirit.tauri-poc",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev:tauri-ui",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Screen Spirit Tauri POC",
        "width": 600,
        "height": 400,
        "visible": false,
        "fullscreen": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [],
    "targets": "all"
  }
}
